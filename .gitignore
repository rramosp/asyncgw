# ------------------------------------------------------------------------------
# Terraform & Infrastructure as Code
# ------------------------------------------------------------------------------
# Local .terraform cache directory
**/.terraform/*
.terraform/

# Terraform State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all local .tfvars files with project-specific variables/credentials
*.tfvars
*.tfvars.json

# Keep example tfvars files tracked
!terraform.tfvars.example
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration & plan files
.terraformrc
terraform.rc
*.tfplan

# ------------------------------------------------------------------------------
# Apigee & Build Deployment Artifacts
# ------------------------------------------------------------------------------
apigee/*.zip
apigee/proxy_bundle/*.zip
*.zip
*.tar.gz

# GCP Service Account Keys & Secrets
*service_account*.json
*service-account*.json
*credentials*.json
*gcp-key*.json
client_secret*.json

