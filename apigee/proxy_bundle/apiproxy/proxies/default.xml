<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Default Proxy Endpoint for Async Gateway</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>Verify-API-Key</Name>
            </Step>
            <Step>
                <Name>Quota-Limit</Name>
            </Step>
            <Step>
                <Name>Assign-Request-ID</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="ChatCompletions">
            <Description>OpenAI Chat Completions Async Routing</Description>
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/v1/chat/completions") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="BatchCompletions">
            <Description>OpenAI Batches Submission and Status</Description>
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/v1/batches/**")</Condition>
        </Flow>
        <Flow name="RequestStatus">
            <Description>Request Polling and Response Retrieval</Description>
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/v1/requests/**")</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/asyncgw</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
