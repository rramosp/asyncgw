<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Target Endpoint connecting to Cloud Run Gateway backend</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <Properties/>
        <URL>https://asyncgw-gateway-SERVICE_HASH-uc.a.run.app</URL>
        <Authentication>
            <GoogleIDToken>
                <Audience>https://asyncgw-gateway-SERVICE_HASH-uc.a.run.app</Audience>
            </GoogleIDToken>
        </Authentication>
    </HTTPTargetConnection>
</TargetEndpoint>
