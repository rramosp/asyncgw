FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1     PORT=8080

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config/ ./config/
COPY asyncgw/ ./asyncgw/

EXPOSE 8080 8000

ENTRYPOINT ["python", "-m", "asyncgw.main"]
CMD ["gateway"]
